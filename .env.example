# Keep the default "mock" adapter for offline demo scans.
VULNORA_TARGET_ADAPTER=mock

# Required only when VULNORA_TARGET_ADAPTER=bedrock.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_BEARER_TOKEN_BEDROCK=

# Required only when VULNORA_TARGET_ADAPTER=nvidia.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
